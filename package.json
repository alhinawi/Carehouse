{
  "name": "carehouse",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "tsc --noEmit && next build && node scripts/security-headers.mjs",
    "preview": "wrangler pages dev out --port 8788",
    "db:local": "wrangler d1 migrations apply carehouse --local",
    "test": "vitest run tests/unit.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@hono/zod-validator": "^0.7.4",
    "hono": "^4.10.6",
    "lucide-react": "^0.468.0",
    "next": "^16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.4.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261118.1",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wrangler": "4.164.0"
  },
  "overrides": {
    "picomatch": "4.0.7",
    "fdir": "6.5.0",
    "tinyglobby": "0.2.17"
  }
}
